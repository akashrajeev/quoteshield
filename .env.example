# Copy to .env and fill keys locally. Never commit .env or paste keys into chat.
# Shell environment wins over .env. Select gemini, groq, openrouter, or nvidia.
SHIELD_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
# Optional base URL overrides (no /chat/completions suffix). Omit for hosted defaults.
# NVIDIA_BASE_URL=http://localhost:8000/v1
